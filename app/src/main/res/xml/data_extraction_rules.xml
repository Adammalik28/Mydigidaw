<?xml version="1.0" encoding="utf-8"?>
<!-- Data aplikasi (termasuk brankas) tidak ikut dicadangkan/dipindahkan otomatis oleh Android.
     Gunakan menu Pengaturan > Cadangkan data di dalam aplikasi. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
